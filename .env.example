# 后端私密配置；复制为 .env。不要提交 .env。
PORT=3001
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# 选择同时支持图片输入、chat/completions 和 JSON 输出的模型。
AI_MODEL=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 前端公开配置：本地开发留空，Vite 会代理 /api 到 3001。
# GitHub Pages 部署时填写后端 HTTPS 地址，不含 /api。
VITE_API_BASE_URL=
